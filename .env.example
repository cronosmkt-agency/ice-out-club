# ==========================================
# ICE OUT CLUB — VARIÁVEIS DE AMBIENTE
# ==========================================

# 1. STRIPE (Pagamentos via PIX e Cartão de Crédito)
# Obtenha em: https://dashboard.stripe.com/apikeys
# Chave Secreta (sk_test_... ou sk_live_...)
STRIPE_SECRET_KEY=sk_test_sua_chave_secreta_aqui

# Chave Publicável (pk_test_... ou pk_live_...)
STRIPE_PUBLISHABLE_KEY=pk_test_sua_chave_publicavel_aqui

# Segredo do Webhook (whsec_...)
# Obtenha em: https://dashboard.stripe.com/webhooks após cadastrar a URL /api/webhook
STRIPE_WEBHOOK_SECRET=whsec_seu_segredo_de_webhook_aqui


# 2. CAMISARIA DIMONA (Print-on-Demand / Dropsimples)
# Obtenha em: https://camisadimona.com.br no seu painel de lojista (Avançado > Chave de API)
DIMONA_API_KEY=sua_chave_api_dimona_aqui
DIMONA_API_URL=https://camisadimona.com.br/api/v1/orders


# 3. CONFIGURAÇÕES GERAIS
PORT=3000
NODE_ENV=production
